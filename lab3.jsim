.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* The full adder used here uses a NAND implementation for both sum and carry; 
* we have found empirically that it is faster than an XOR sum implementation.
*******************************************************************************
.subckt fa a b c_in sum c_out
* Xn_ circuits are for generating the inverted inputs
    Xn1 a a_not inverter
    Xn2 b b_not inverter
    Xn3 c_in c_not inverter
* Xs_ circuits are for sum
    Xs1 a b_not c_not pn1 nand3
    Xs2 a_not b_not c_in pn2 nand3
    Xs3 a_not b c_not pn3 nand3
    Xs4 a b c_in pn4 nand3
    Xs5 pn1 pn2 pn3 pn4 sum nand4
* Xc_ circuits are for carry
    Xc1 a c_in p1 nand2
    Xc2 b c_in p2 nand2
    Xc3 a b p3 nand2
    Xc4 p1 p2 p3 c_out nand3
.ends

*******************************************************************************
* This 32-bit adder subcircuit has 32 bits for the addends, and one bit for the 
* first carry_in (the rest of the carry_in bits will be derived from previous
* instances of fa).
* There are 32 sum bits, corresponding to the 32 full-adders.
* The last two carry output bits are included in the circuit instantiation, 
* as instructed.
*******************************************************************************
.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
* Xadd_init is the first full-adder circuit. Coding it separately is
* necessary to generate the first cout bit that will be used as carry_in for
* the rest of the adders.
    Xadd_init a0 b0 cin0 sum0 cout0 fa
* Xadd generates the other 31 full-adders. It takes the previous cout as its
* carry input.
    Xadd a[1:31] b[1:31] cout[0:30] sum[1:31] cout[1:31] fa
.ends

Wa a[31:0] nrz(0, 5, 20ns, 0ns, 0.001ns, 0.001ns)
+ 0x7FFFFF9C 0x55555555 0x00000000 0x55555555 0xFFFFFFFF
+ 0xAAAAAAAA 0x00000000 0xAAAAAAAA 0x00000001 0xFFFFFFFF

Wb b[31:0] nrz(0, 5, 20ns, 0ns, 0.001ns, 0.001ns)
+ 0x7FFFFFCE 0x00000000 0x55555555 0x55555555 0xFFFFFFFF
+ 0x00000000 0xAAAAAAAA 0xAAAAAAAA 0xFFFFFFFF 0x00000001

Xsum a[31:0] b[31:0] 0 sum[31:0] c[31:30] add32

.tran 200ns
.plot a[31:0]
.plot b[31:0]
.plot sum[31:0] 
.plot cout[31:30]